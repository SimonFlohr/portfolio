while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "husky > pre-push: pushing to 'main' is blocked. Push a feature branch and open a PR."
    exit 1
  fi
done

echo "husky > pre-push: format + lint + typecheck + build (mirrors CI)"
pnpm verify
